# Copy to .env (git-ignored) and adjust. direnv loads it via .envrc.

# Full path to the PrusaSlicer executable. Leave unset to auto-detect
# (PATH, /Applications/**/PrusaSlicer.app, standard Linux/Windows locations).
# macOS example (nonstandard install folder):
# PRUSASLICER_PATH="/Applications/Original Prusa Drivers/PrusaSlicer.app/Contents/MacOS/PrusaSlicer"

# PrusaSlicer configuration directory (profiles). Leave unset for the platform default:
#   macOS:   ~/Library/Application Support/PrusaSlicer
#   Linux:   ~/.config/PrusaSlicer
#   Windows: %APPDATA%\PrusaSlicer
# PRUSASLICER_DATADIR=

# Where sliced G-code is written when no output path is given.
# Default: ./output relative to the server's working directory.
# PRUSASLICER_MCP_OUTPUT_DIR=

# Per-slice timeout in seconds (default 600).
# PRUSASLICER_MCP_TIMEOUT=600
